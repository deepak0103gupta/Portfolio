# Copy these into Vercel: Project > Settings > Environment Variables
# (for local testing you can also put them in a .env.local file and run `vercel dev`)

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered.
# With Resend's free shared sender this MUST be the email you signed up to Resend with.
CONTACT_TO_EMAIL=deepak0103gupta@gmail.com

# Optional. Leave unset to use Resend's shared sender (onboarding@resend.dev).
# Set it only after verifying your own domain in Resend, e.g. "Portfolio <contact@yourdomain.com>"
# CONTACT_FROM_EMAIL=
